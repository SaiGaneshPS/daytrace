<?xml version="1.0" encoding="utf-8"?>
<!-- DT-19: permissions, the activity and the network security config. Later tickets add the sync worker (DT-21),
     discovery (DT-22), Health Connect and calendar reads (DT-23) and the live-mode service (DT-24). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to the hub on your own network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Which apps you used and for how long (granted in Settings > Usage access, not by a dialog). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- App names for those package IDs. Allowed here because the app is not distributed on the Play Store. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Nudges (DT-24) and today's calendar (DT-23). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Health Connect: last night's sleep, daily steps and meals (DT-23). Read only. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <!-- Syncs run in the background, and reading there needs this one too (asked where the phone offers it). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Live mode (DT-24): a foreground service, with its notice, that sends app use to the hub within seconds. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <!-- The Health Connect app on Android 13 and older. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- allowBackup=false: the event store and the hub token must never be copied to a cloud backup. -->
    <application
        android:name=".DaytraceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Daytrace"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Daytrace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect opens this to show why the app asks for health data (Android 13 and older). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- The same explanation on Android 14 and newer, where Health Connect is part of the system. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- DT-58: the Dashboard tab's WebView sends nothing to Google: no Safe Browsing checks, no usage metrics. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- DT-58: the home-screen widget (today's screen time, the streak and the main goal). -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="Daytrace today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Live mode: started only from the app's screen, never by itself. -->
        <service
            android:name=".live.LiveModeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
