<?xml version="1.0" encoding="utf-8"?>
<!-- DT-19: the app only talks to your own hub on your own network, whose address (a LAN IP) is not known in
     advance, so plain HTTP is allowed. DT-47 switches the hub to HTTPS and pins its local CA here. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
