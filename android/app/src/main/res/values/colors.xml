<?xml version="1.0" encoding="utf-8"?>
<!-- DT-19 app colors, plus DT-52's design tokens for DT-58 (the Android dashboard tab and widget). The values mirror
     dashboard/src/theme/tokens.css; keep the two in step. "fill" colors are for chart marks and swatches, "ink"
     colors for text; each has a light and a dark version (_dark). -->
<resources>
    <color name="daytrace_background">#FFFFF8F2</color>
    <color name="daytrace_background_night">#FF141122</color> <!-- Compose's Night: the dark window before it draws -->
    <color name="daytrace_icon_background">#FF3B2A8C</color>

    <!-- surfaces, text and accent -->
