root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,kt,kts}]
indent_size = 4

[*.{ps1,bat,cmd}]
end_of_line = crlf

# Windows PowerShell 5.1 reads BOM-less scripts with the ANSI code page.
[*.ps1]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false
