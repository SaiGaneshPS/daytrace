{
  "name": "daytrace-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Daytrace PWA dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test:e2e": "tsc -p tsconfig.e2e.json && playwright test",
    "preview": "vite preview",
    "gen:api": "openapi-typescript http://127.0.0.1:8765/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "echarts": "^6.1.0",
    "html-to-image": "^1.11.13",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
